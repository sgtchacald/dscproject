# Modelo do /opt/dscproject/<hml|prod>/.env na VPS (NUNCA versionar o .env real).
#   cp .env.example .env && chmod 600 .env && nano .env
# Gere cada segredo com:  openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
# hml e prod usam segredos DIFERENTES.

# hml | prod  (define o perfil Spring e o nome do projeto compose)
AMBIENTE=prod

# Endereco publico usado nos links de e-mail (sem barra no final)
#   prod: https://dscproject.com.br     hml: https://hml.dscproject.com.br
APP_BASE_URL=https://dscproject.com.br

# Imagem (o deploy.sh informa a tag). Troque se o repositorio mudar de dono/nome.
APP_IMAGEM=ghcr.io/sgtchacald/dscproject

#BANCO (MySQL proprio deste ambiente, sem porta publicada)
MYSQL_BANCO=dsc_prod_bd
MYSQL_USUARIO=dsc_app
MYSQL_SENHA=
MYSQL_ROOT_SENHA=

#SEGREDOS DA APLICACAO (obrigatorios em hml/prod)
APP_REMEMBER_ME_KEY=

#E-MAIL (senha de app do Gmail, 16 caracteres sem espacos)
GMAIL_APP_EMAIL=
GMAIL_APP_SENHA=

#ADMIN INICIAL — criado so se nao existir ADMIN ativo. Depois do 1o login, troque a
# senha pela tela e esvazie APP_ADMIN_SENHA.
APP_ADMIN_LOGIN=admin
APP_ADMIN_EMAIL=
APP_ADMIN_SENHA=
APP_ADMIN_NOME=Administrador
APP_ADMIN_OBRIGATORIO=true

#RECURSOS (KVM 2 = 8 GB). Sugestao:
#   prod: APP_MEMORIA=1536m  MYSQL_MEMORIA=1g    MYSQL_BUFFER_POOL=512M
#   hml:  APP_MEMORIA=1g     MYSQL_MEMORIA=768m  MYSQL_BUFFER_POOL=256M
APP_MEMORIA=1536m
MYSQL_MEMORIA=1g
MYSQL_BUFFER_POOL=512M
MYSQL_MAX_CONEXOES=40

#BACKUP (backup-mysql.sh)
# Dias de retencao local dos dumps diarios
BACKUP_RETENCAO_DIAS=7
# Os dumps ficam SO nesta VPS: perder a VPS = perder os dumps (ver manual, secao 8).
# Healthchecks.io (opcional): URL de ping do check deste ambiente. O backup diario
# avisa sucesso/falha; sem ping no prazo, o Healthchecks.io manda alerta.
BACKUP_HEALTHCHECK_URL=
