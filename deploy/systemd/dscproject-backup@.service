# Backup diario do MySQL de um ambiente. Instancia = hml | prod
#   sudo cp dscproject-backup@.* /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now dscproject-backup@prod.timer dscproject-backup@hml.timer
[Unit]
Description=Backup MySQL dscproject (%i)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/usr/bin/bash /opt/dscproject/%i/backup-mysql.sh diario
Nice=10
IOSchedulingClass=idle
